{
  "name": "kolshek",
  "version": "0.4.8-fork.1",
  "description": "CLI tool for tracking finances from Israeli banks and credit cards (כל שקל) — Fork of KolShek",
  "type": "module",
  "bin": {
    "kolshek": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i src/web/styles.css -o src/web/dist/styles.css --minify",
    "dev:css": "tailwindcss -i src/web/styles.css -o src/web/dist/styles.css --watch",
    "dev:web": "vite --config src/web/app/vite.config.ts",
    "build:web": "vite build --config src/web/app/vite.config.ts",
    "prebuild": "npm run build:web && tsx scripts/generate-web-embed.ts && tsx scripts/generate-plugin-embed.ts",
    "build": "tsc"
  },
  "keywords": [
    "israel",
    "finance",
    "banking",
    "credit-card",
    "cli",
    "scraper"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "better-sqlite3": "^13.1.1",
    "chalk": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "commander": "^15.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "debug": "^4.4.3",
    "env-paths": "^4.0.0",
    "express": "^5.3.0",
    "israeli-bank-scrapers-core": "github:Isaac-D20/israeli-bank-scrapers",
    "lucide-react": "^1.72.0",
    "ora": "^10.0.0",
    "puppeteer-core": "^25.17.0",
    "puppeteer-extra": "^2.1.3",
    "puppeteer-extra-plugin-stealth": "^2.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "tailwindcss": "^4.3.5",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "puppeteer": "^25.17.0",
    "puppeteer-core": "^25.17.0"
  },
  "trustedDependencies": [],
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.18": true,
    "better-sqlite3@13.1.1": true,
    "esbuild@0.28.2": true,
    "github:Isaac-D20/israeli-bank-scrapers#572055eeb117784c7ca15a59335b089818acb37b": true,
    "puppeteer@24.43.1": true,
    "puppeteer@25.17.0": true
  }
}
